<odoo>

    <record id="l10n_br_cnpj_search_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form (in l10n_br_cnpj_search)</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_br_base.l10n_br_base_res_config_settings_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//app" position="inside">
                <group
                    string="Brazilian CNPJ service API"
                    id="l10n_br_cnpj_search_api"
                    invisible="disable_cpf_cnpj_validation">
                    <div class="text-muted">
                        Brazilian CNPJ service API to search partner information using cnpj code.
                    </div>
                    <setting 
                        string="CNPJ Provider">
                        <field 
                            name="cnpj_provider"/>
                    </setting>
                    <setting
                        string="Serpro Token" 
                        invisible="cnpj_provider != 'serpro'">
                        <field 
                            name="serpro_token" 
                            required="cnpj_provider == 'serpro'"/>
                    </setting>
                    <setting 
                        string="Serpro Trial" 
                        invisible="cnpj_provider != 'serpro'">
                        <field 
                            name="serpro_trial" 
                            required="cnpj_provider == 'serpro'"/>
                    </setting>
                    <setting 
                        string="Serpro Schema" 
                        invisible="cnpj_provider != 'serpro'">
                        <field 
                            name="serpro_schema" 
                            required="cnpj_provider == 'serpro'"/>
                    </setting>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
