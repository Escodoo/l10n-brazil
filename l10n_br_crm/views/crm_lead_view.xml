<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_crm_leads_form" model="ir.ui.view">
        <field name="name">l10n_br_crm.leads.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="show_l10n_br" invisible="1" />
                <field name="street" invisible="not show_l10n_br" />
            </field>

            <xpath expr="//group[@name='lead_info']/div" position="after">
                <field name="name_surname" />
                <field name="cpf" invisible="not show_l10n_br" />
                <field name="rg" invisible="not show_l10n_br" />
            </xpath>

            <xpath
                expr="//group[@name='lead_partner']/field[@name='partner_name']"
                position="after"
            >
                <field name="legal_name" invisible="not show_l10n_br" />
                <field name="cnpj" invisible="not show_l10n_br" />
                <field name="inscr_est" invisible="not show_l10n_br" />
            </xpath>

            <xpath
                expr="//group[@name='lead_partner']/field[@name='website']"
                position="before"
            >
                <field name="inscr_mun" invisible="not show_l10n_br" />
                <field name="suframa" invisible="not show_l10n_br" />
            </xpath>

            <xpath
                expr="//page[@name='lead']//group/field[@name='partner_name']"
                position='after'
            >
                <field name="legal_name" invisible="not show_l10n_br" />
                <field name="cnpj" invisible="not show_l10n_br" />
                <field name="inscr_est" invisible="not show_l10n_br" />
            </xpath>
            <xpath
                expr="//page[@name='lead']//group/field[@name='website']"
                position='before'
            >
                <field name="inscr_mun" invisible="not show_l10n_br" />
                <field name="suframa" invisible="not show_l10n_br" />
            </xpath>
            <xpath
                expr="//page[@name='lead']//group/field[@name='function']"
                position='before'
            >
                <field name="name_surname" />
                <field name="cpf" invisible="not show_l10n_br" />
                <field name="rg" invisible="not show_l10n_br" />
            </xpath>
        </field>
    </record>

</odoo>
