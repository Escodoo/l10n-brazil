<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="portal_my_details_fields" inherit_id="portal.portal_my_details_fields">
        <xpath expr="//div[@t-if='not partner_can_edit_vat']/small" position="replace">
            <small class="form-text text-muted">
                Fiscal information can not be changed once document(s) have been issued for your account.
                <br/>Please contact us directly for that operation.
            </small>
        </xpath>
        <xpath expr="//input[@name='name']/.." position="after">
            <div
                t-attf-class="mb-3 #{error.get('legal_name') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label label-optional"
                    for="legal_name"
                >Razão Social / Nome Completo</label>
                <input
                    t-if="partner_can_edit_vat"
                    type="text"
                    name="legal_name"
                    t-attf-class="form-control #{error.get('legal_name') and 'is-invalid' or ''}"
                    t-att-value="legal_name or partner.legal_name"
                    t-att-disabled="None if partner_can_edit_vat else '1'"
                />
                <small t-else="" class="form-text text-muted d-block d-xl-none">
                    Changing company name is not allowed once document(s) have been issued for your account. Please contact us directly for this operation.
                </small>
            </div>
            <div class="clearfix" />

            <div
                t-attf-class="mb-1 #{error.get('cnpj_cpf') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label label-optional"
                    for="cnpj_cpf"
                >CNPJ/CPF</label>
                <input
                    type="text"
                    name="cnpj_cpf"
                    t-attf-class="input-cnpj-cpf form-control #{error.get('cnpj_cpf') and 'is-invalid' or ''}"
                    t-att-value="cnpj_cpf or partner.cnpj_cpf"
                    t-att-disabled="None if partner_can_edit_vat else '1'"
                    t-att-title="None if partner_can_edit_vat else 'Changing cnpj/cpf number is not allowed once document(s) have been issued for your account. Please contact us directly for this operation.'"
                />
            </div>

            <div
                t-attf-class="mb-3 #{error.get('inscr_est') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label label-optional"
                    for="inscr_est"
                >IE/RG</label>
                <input
                    type="text"
                    name="inscr_est"
                    t-attf-class="form-control #{error.get('inscr_est') and 'is-invalid' or ''}"
                    t-att-value="inscr_est or partner.inscr_est"
                    t-att-disabled="None if partner_can_edit_vat else '1'"
                    t-att-title="None if partner_can_edit_vat else 'Changing IE/RG number is not allowed once document(s) have been issued for your account. Please contact us directly for this operation.'"
                />
            </div>

            <div
                t-attf-class="form-group #{error.get('inscr_mun') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label label-optional"
                    for="inscr_mun"
                >Inscrição Municipal</label>
                <input
                    type="text"
                    name="inscr_mun"
                    t-attf-class="form-control #{error.get('inscr_mun') and 'is-invalid' or ''}"
                    t-att-value="inscr_mun or partner.inscr_mun"
                    t-att-disabled="None if partner_can_edit_vat else '1'"
                    t-att-title="None if partner_can_edit_vat else 'Changing nscrição Municipal number is not allowed once document(s) have been issued for your account. Please contact us directly for this operation.'"
                />
            </div>
        </xpath>

        <xpath expr="//input[@name='company_name']/.." position="attributes">
            <attribute name="t-if" add="False" separator=" and " />
        </xpath>
        <xpath expr="//input[@name='vat']/.." position="attributes">
            <attribute name="t-if" add="False" separator=" and " />
        </xpath>
        <xpath expr="//input[@name='phone']/.." position="after">
            <div
                t-attf-class="mb-3 #{error.get('mobile') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label"
                    for="mobile"
                >Mobile</label>
                <input
                    type="tel"
                    name="mobile"
                    t-attf-class="form-control #{error.get('mobile') and 'is-invalid' or ''}"
                    t-att-value="mobile or partner.mobile"
                />
            </div>
        </xpath>
        <xpath expr="//input[@name='street']/.." position="attributes">
            <attribute name="t-if" add="False" separator=" and " />
        </xpath>
        <xpath expr="//label[@for='street']/.." position="before">
            <div t-attf-class="mb-3 #{error.get('street_name') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label" for="street_name">Street</label>
                <input type="text" name="street_name" t-attf-class="form-control #{error.get('street_name') and 'is-invalid' or ''}" t-att-value="street_name or partner.street_name"/>
            </div>
        </xpath>
        <xpath expr="//input[@name='street']/.." position="after">
            <div
                t-attf-class="mb-3 #{error.get('street_number') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label"
                    for="street_number"
                >Nº</label>
                <input
                    type="text"
                    name="street_number"
                    t-attf-class="form-control #{error.get('street_number') and 'is-invalid' or ''}"
                    t-att-value="street_number or partner.street_number"
                />
            </div>
            <div
                t-attf-class="mb-3 #{error.get('street2') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label"
                    for="street2"
                >Complemento</label>
                <input
                    type="text"
                    name="street2"
                    t-attf-class="form-control #{error.get('street2') and 'is-invalid' or ''}"
                    t-att-value="street2 or partner.street2"
                />
            </div>
            <div
                t-attf-class="mb-3 #{error.get('district') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label"
                    for="district"
                >Bairro</label>
                <input
                    type="text"
                    name="district"
                    t-attf-class="form-control #{error.get('district') and 'is-invalid' or ''}"
                    t-att-value="district or partner.district"
                />
            </div>
            <div
                t-attf-class="mb-3 #{error.get('city_id') and 'o_has_error' or ''} col-xl-6"
            >
                <label
                    class="col-form-label label-optional"
                    for="state_id"
                >Cidade</label>
                <select
                    name="city_id"
                    t-attf-class="form-select #{error.get('city_id') and 'is-invalid' or ''}"
                >
                    <option value="">City...</option>
                    <t t-foreach="cities" t-as="city">
                        <option
                            t-att-value="city.id"
                            style="display:none;"
                            t-att-data-state_id="city.state_id.id"
                            t-att-selected="(int(city_id) if city_id else partner.city_id.id) == city.id"
                            t-esc="city.name"
                        />
                    </t>
                </select>
            </div>
        </xpath>
        <xpath expr="//input[@name='city']/.." position="attributes">
            <attribute name="t-if" add="False" separator=" and " />
        </xpath>
    </template>

</odoo>
