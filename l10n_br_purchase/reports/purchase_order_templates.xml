<?xml version="1.0" encoding="utf-8" ?>
<!-- pylint:disable=file-not-used -->
<odoo>

    <template id="document_tax_totals" inherit_id="purchase.document_tax_totals">
        <!-- Inclusão de outros Totais usados no Brasil -->
        <xpath
            expr="//tr[hasclass('border-black')]"
            position="before"
        >
            <tr>
                <td>Gross</td>
                <td class="text-right">
                    <span
                            t-field="o.amount_price_gross"
                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                        />
                </td>
            </tr>
            <tr>
                <td>Discount</td>
                <td class="text-right">
                    <span
                            t-field="o.amount_discount_value"
                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                        />
                </td>
            </tr>
        </xpath>
        <xpath
            expr="//tr[hasclass('border-black')]"
            position="after"
        >
            <tr>
                <td>Freight</td>
                <td class="text-right">
                    <span
                        t-field="o.amount_freight_value"
                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                    />
                </td>
            </tr>
            <tr>
                <td>Insurance</td>
                <td class="text-right">
                    <span
                        t-field="o.amount_insurance_value"
                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                    />
                </td>
            </tr>
            <tr>
                <td>Other Costs</td>
                <td class="text-right">
                    <span
                        t-field="o.amount_other_value"
                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                    />
                </td>
            </tr>
        </xpath>
    </template>

</odoo>
