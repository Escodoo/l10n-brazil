<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_br_sale_res_config_settings_form" model="ir.ui.view">
        <field name="name">l10n_br_sale.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='sales_settings_invoicing_policy']" position="after">
                <setting help="Copy sale order notes in fiscal document">
                    <field name="copy_note" />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
